'दान सेवा (Donation Seva)|Donation Seva|दान सेवा\n'+
'कस्टम डायनामिक विकल्प|Custom Dynamic Options|कस्टम डायनॅमिक पर्याय\n'+
'+ नई मनचाही कैटेगरी बनाएं (Custom Category)|+ Create Your Own Category|+ स्वतःची नवी वर्गवारी बनवा\n'+
'प्रदर्शन क्रम (Sequence Number)|Display Order (Sequence No.)|प्रदर्शन क्रम (क्रमांक)\n'+
'स्लाइड का समय (Seconds)|Slide Duration (Seconds)|स्लाइडचा वेळ (सेकंद)\n'+
'पहले से सुरक्षित क्रम|Orders Already Used|आधीच वापरलेले क्रम\n'+
'क्रम जाँचा जा रहा है...|Checking orders...|क्रम तपासत आहे...\n'+
'कस्टम कैटेगरी बिल्डर (बिना ऐप अपडेट किए दिखेगी)|Custom Category Builder (no app update needed)|कस्टम वर्ग बिल्डर (ॲप अपडेटशिवाय दिसेल)\n'+
'कैटेगरी का नाम (Title)|Category Name (Title)|वर्गाचे नाव (Title)\n'+
'ऊपर दिखने वाला टैग (Badge)|Top Tag (Badge)|वर दिसणारा टॅग (Badge)\n'+
'बैकग्राउंड कलर ग्रेडिएंट|Background Color Gradient|बॅकग्राउंड कलर ग्रेडियंट\n'+
'सर्वोत्तम इमेज साइज़ गाइड (Image Resolution Guide)|Best Image Size Guide|सर्वोत्तम इमेज साइज गाइड\n'+
'इमेज बैनर फ़ाइल (मल्टीपल इमेजेस सपोर्ट)|Image Banner File (Multiple Images Supported)|इमेज बॅनर फाइल (एकाधिक इमेजेस सपोर्ट)\n'+
'फोटो चुनें (Click to Select Image)|Choose Photo (Tap to Select)|फोटो निवडा (निवडण्यासाठी टॅप करा)\n'+
'अपलोड करें (Upload to Cloud)|Upload to Cloud|क्लाउडवर अपलोड करा\n'+
'इमेज डायरेक्ट लिंक (Direct Cloud Asset URL)|Image Direct Link (Cloud URL)|इमेज थेट लिंक (Cloud URL)\n'+
'तारीख (Event Date)|Event Date|कार्यक्रम तारीख\n'+
'नाम / मुख्य शीर्षक #1|Name / Title #1|नाव / मुख्य शीर्षक #1\n'+
'पद / सेवा / राशि|Role / Seva / Amount|पद / सेवा / रक्कम\n'+
'स्थान / पता|City / Location|ठिकाण / पत्ता\n'+
'लाइव मोबाइल प्रीव्यू (यूज़र ऐप में कैसा दिखेगा)|Live Mobile Preview (as in user app)|लाइव्ह मोबाइल प्रिव्ह्यू (युजर ॲपमध्ये कसे दिसेल)\n'+
'क्लिक करने पर क्या हो? (Action)|On Click (Action)|क्लिक केल्यावर काय? (Action)\n'+
'कोई लिंक नहीं (No Action)|No Link (No Action)|लिंक नाही (No Action)\n'+
'ऐप का आंतरिक पेज खोलें (.html)|Open internal app page (.html)|ॲपचे अंतर्गत पेज उघडा (.html)\n'+
'बाहरी वेबसाइट खोलें (URL)|Open external website (URL)|बाह्य वेबसाइट उघडा (URL)\n'+
'लिंक का पता (Target Page / URL)|Link Target (Page / URL)|लिंकचा पत्ता (Page / URL)\n'+
'स्लाइड ऐप में लाइव करें (PUBLISH)|Publish Slide to App|स्लाइड ॲपमध्ये लाइव्ह करा\n'+
'रद्द करें (CANCEL)|Cancel|रद्द करा\n'+
'ऐप में चल रही सभी एक्टिव स्लाइड्स|All Active Slides in the App|ॲपमध्ये चालू असलेल्या सर्व स्लाइड्स\n'+
'अभी कोई एक्टिव स्लाइड नहीं है।|No active slides yet.|अजून कोणतीही सक्रिय स्लाइड नाही.\n'+
'स्लाइड एडिट मोड|Slide Edit Mode|स्लाइड संपादन मोड\n'+
'स्लाइड अपडेट करें|Update Slide|स्लाइड अपडेट करा\n'+
'क्रम:|Order:|क्रम:\n'+
'घड़ी:|Clock:|घड्याळ:\n'+
'नया लेवल जोड़ें|Add New Level|नवीन लेव्हल जोडा\n'+
'लेवल चुनकर प्रश्न प्रबंधित करें|Select a level to manage questions|लेव्हल निवडून प्रश्न व्यवस्थापित करा\n'+
'लेवल डिलीट करें|Delete Level|लेव्हल हटवा\n'+
'नया प्रश्न जोड़ें|Add New Question|नवीन प्रश्न जोडा\n'+
'सही उत्तर (Correct Option)|Correct Answer|बरोबर उत्तर\n'+
'प्रश्न सुरक्षित करें|Save Question|प्रश्न जतन करा\n'+
'प्रश्न (हिंदी)|Question (Hindi)|प्रश्न (हिंदी)\n'+
'प्रश्न (मराठी)|Question (Marathi)|प्रश्न (मराठी)\n'+
'कोई लेवल नहीं मिला|No levels found|एकही लेव्हल सापडला नाही\n'+
'अभी कोई प्रश्न नहीं है।|No questions yet.|अजून एकही प्रश्न नाही.\n'+
'उत्तर:|Answer:|उत्तर:\n'+
'ऐप सिंक हो गया!|App synced!|ॲप सिंक झाले!\n'+
'क्रम सुरक्षित हो गया|Order saved|क्रम जतन झाला\n'+
'सफलतापूर्वक पब्लिश हुआ!|Published successfully!|यशस्वीरित्या प्रकाशित झाले!\n'+
'स्लाइड डिलीट करें?|Delete this slide?|स्लाइड हटवायची?\n'+
'हाँ, हटाएं|Yes, delete|होय, हटवा\n'+
'त्रुटि|Error|त्रुटी\n'+
'सूचना|Notice|सूचना\n'+
'क्रम व्यस्त है|Order is taken|क्रम व्यस्त आहे\n'+
'ऑप्टिमाइज़ हो रहा है...|Optimizing...|ऑप्टिमाइझ होत आहे...\n'+
'सफलतापूर्वक अपलोड हुआ!|Uploaded successfully!|यशस्वीरित्या अपलोड झाले!\n'+
'अपलोड हो रहा है...|Uploading...|अपलोड होत आहे...\n'+
'अपलोड पूरा हुआ!|Upload complete!|अपलोड पूर्ण झाले!\n'+
'दोबारा प्रयास करें|Try again|पुन्हा प्रयत्न करा\n'+
'अपलोड विफल|Upload failed|अपलोड अयशस्वी\n'+
'लेवल हटाएं?|Delete level?|लेव्हल हटवायचा?\n'+
'प्रश्न सुरक्षित हो गया!|Question saved!|प्रश्न जतन झाला!\n'+
'कृपया पहले कोई फोटो चुनें!|Please select a photo first!|कृपया आधी फोटो निवडा!\n'+
'क्लाउड स्टोरेज Key|Cloud Storage Key|क्लाउड स्टोरेज Key\n'+
'नया GitHub Token (Classic) यहाँ पेस्ट करें:|Paste your new GitHub Token (Classic) here:|नवीन GitHub Token (Classic) येथे पेस्ट करा:\n'+
'यह आपके डिवाइस में सुरक्षित रहेगा और कभी ब्लॉक नहीं होगा।|It stays saved on your device, so you will not need to enter it again.|हे तुमच्या डिव्हाइसमध्ये सुरक्षित राहील, पुन्हा टाकावे लागणार नाही.\n'+
'सुरक्षित करें (Save Key)|Save Key|Key जतन करा\n'+
'Key दर्ज करना आवश्यक है!|Key is required!|Key टाकणे आवश्यक आहे!\n'+
'Key सुरक्षित हो गई!|Key saved!|Key जतन झाली!\n'+
'नई Key दर्ज करें|Enter new Key|नवीन Key टाका\n'+
'क्लाउड Key एक्सपायर या ब्लॉक हो चुकी है। कृपया नई Key दर्ज करें।|Cloud Key has expired or been blocked. Please enter a new Key.|क्लाउड Key कालबाह्य किंवा ब्लॉक झाली आहे. कृपया नवीन Key टाका.';
var K=D.split('\n').map(function(l){return l.split('|')}).sort(function(a,b){return b[0].length-a[0].length});
function conv(s,l){if(l==='hi')return s;var o=s,j=l==='en'?1:2;for(var i=0;i<K.length;i++){if(o.indexOf(K[i][0])>-1)o=o.split(K[i][0]).join(K[i][j])}return o}
var OR=new WeakMap(),lang='en';
function tn(n,l){var p=n.parentNode;if(!p)return;var t=p.nodeName;if(t==='SCRIPT'||t==='STYLE'||t==='TEXTAREA')return;
var o=OR.has(n)?OR.get(n):n.nodeValue;var r=conv(o,l);
if(OR.has(n)){n.nodeValue=r}else if(r!==o){OR.set(n,o);n.nodeValue=r}}
var AT=['placeholder','label','title'];
function at(el,l){AT.forEach(function(a){var v=el.getAttribute&&el.getAttribute(a);if(v===null||v===undefined)return;var k='_o'+a;
if(el[k]===undefined){if(conv(v,'en')===v)return;el[k]=v}el.setAttribute(a,conv(el[k],l))})}
function walk(r,l){
if(r.nodeType===3){tn(r,l);return}
if(r.nodeType!==1)return;
var w=document.createTreeWalker(r,4,null,false),n,a=[];while((n=w.nextNode()))a.push(n);
a.forEach(function(x){tn(x,l)});
at(r,l);r.querySelectorAll('[placeholder],[label],[title]').forEach(function(e){at(e,l)})}
var G={en:'• Best size: <b>1200 × 1100 px</b> (about 11:10) for the phone banner.<br>• Any size is shown fully (blur-fill). Keep key content in the centre 80%.',
hi:'• सबसे सटीक साइज़: <b>1200 × 1100 px</b> (लगभग 11:10)।<br>• कोई भी साइज़ पूरी दिखेगी (ब्लर-फिल)। ज़रूरी चीज़ें बीच के 80% में रखें।',
mr:'• सर्वात अचूक साइज: <b>1200 × 1100 px</b> (सुमारे 11:10).<br>• कोणताही साइज पूर्ण दिसेल (ब्लर-फिल). महत्त्वाचा मजकूर मधल्या 80% मध्ये ठेवा.'};
function guide(l){var g=document.querySelector('#boxImageUpload .p-3 > div:nth-of-type(2)');if(g&&g.getAttribute('data-l')!==l){g.setAttribute('data-l',l);g.innerHTML=G[l]}
var b=document.querySelector('#boxImageUpload .p-3 .badge');if(b)b.textContent='≈ 11:10'}
function cur(){try{var v=localStorage.getItem('lang');return(v==='en'||v==='hi'||v==='mr')?v:'en'}catch(e){return'en'}}
function apply(l,save){
lang=l;if(save){try{localStorage.setItem('lang',l)}catch(e){}}
document.documentElement.lang=l;walk(document.body,l);guide(l);
document.querySelectorAll('.lang-sw button').forEach(function(b){b.classList.toggle('on',b.getAttribute('data-l')===l)})}
function sw(){
var h='<button data-l="en">EN</button><button data-l="hi">हिं</button><button data-l="मरा">मरा</button>';
[['#mainSidebar .brand-logo','afterend'],['.mobile-header .mobile-toggle','beforebegin']].forEach(function(p){
var t=document.querySelector(p[0]);if(!t)return;
var d=document.createElement('div');d.className='lang-sw';d.innerHTML=h;t.insertAdjacentElement(p[1],d);
d.addEventListener('click',function(e){var b=e.target.closest('button');if(b)apply(b.getAttribute('data-l'),true)})})}
function logo(){
var svg='<svg viewBox="0 0 48 48" aria-hidden="true"><g fill="#fff"><path d="M24 8c4.5 4.5 5.5 10.5 0 20-5.5-9.5-4.5-15.5 0-20z"/><path d="M12 15c6 1 10.5 6 12 13-7 0-11.5-5-12-13z" opacity=".88"/><path d="M36 15c-6 1-10.5 6-12 13 7 0 11.5-5 12-13z" opacity=".88"/><path d="M6 25c6 0 12 2.500 18 7.500-5 5-14 5-18-7.500z" opacity=".72"/><path d="M42 25c-6 0-12 2.500-18 7.500 5 5 14 5 18-7.500z" opacity=".72"/><path d="M12 38c8 3 16 3 24 0-8 5-16 5-24 0z" opacity=".6"/></g></svg>';
document.querySelectorAll('.img-logo').forEach(function(e){e.innerHTML=svg})}
function pv(){var c=document.getElementById('livePreviewContainer');if(!c)return;var im=c.querySelector('img.sim-image');c.style.setProperty('--pbg',im?'url("'+im.getAttribute('src')+'")':'none')}
var q=[],sc=false;
function flush(){sc=false;var a=q.splice(0);a.forEach(function(n){if(!n.isConnected)return;walk(n,lang);icons(n)});pv()}
new MutationObserver(function(ms){ms.forEach(function(m){m.addedNodes.forEach(function(n){q.push(n)})});if(!sc){sc=true;requestAnimationFrame(flush)}}).observe(document.body,{childList:true,subtree:true});
logo();sw();icons(document.body);apply(cur(),false);pv();
window.addEventListener('storage',function(e){if(e.key==='lang'&&cur()!==lang)apply(cur(),false)});
function re(){var v=cur();if(v!==lang)apply(v,false)}
window.addEventListener('focus',re);document.addEventListener('visibilitychange',re);
})();
</script>
</body>
</html>
