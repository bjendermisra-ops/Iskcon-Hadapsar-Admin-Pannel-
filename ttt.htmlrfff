.dashboard-sidebar .border-top{border-color:rgba(255,255,255,.08)!important}
.dashboard-sidebar .btn-outline-secondary{color:#ffcc99;border-color:rgba(255,204,153,.35)}
.mobile-header{background:rgba(255,255,255,.85);backdrop-filter:blur(14px)}
.card-box{border-radius:22px;position:relative;overflow:hidden}
.card-box::before{content:"";position:absolute;left:0;right:0;top:0;height:4px;background:linear-gradient(90deg,#FF7B00,#FFB347,#FF5722)}
.input-c{border-radius:14px}
.btn-main{border-radius:14px}
.btn-main:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(255,123,0,.4)}
.item-row{border-radius:18px}
.item-row:hover{transform:translateY(-2px)}
.btn-icon{border-radius:12px}
.btn-icon:hover{transform:scale(1.08)}
.ico{width:1.1em;height:1.1em;vertical-align:-.18em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
.ico.spin{animation:proSpin .9s linear infinite}
@keyframes proSpin{to{transform:rotate(360deg)}}
.swal2-popup{border-radius:22px!important;font-family:inherit!important}
.lang-sw{display:flex;gap:6px;padding:12px 14px 0}
.lang-sw button{flex:1;border:1.5px solid rgba(255,255,255,.2);background:transparent;color:#e8cdb4;border-radius:10px;padding:7px 4px;font-weight:800;font-size:.78rem;cursor:pointer;transition:.2s}
.lang-sw button.on{background:linear-gradient(135deg,#FF9933,#E65100);color:#fff;border-color:transparent;box-shadow:0 4px 12px rgba(255,123,0,.4)}
.mobile-header .lang-sw{padding:0;margin-left:auto;margin-right:10px}
.mobile-header .lang-sw button{flex:none;padding:6px 9px;color:#475569;border-color:#E2E8F0}
.mobile-header .lang-sw button.on{color:#fff}
.preview-device-card{height:auto;aspect-ratio:10/9}
.preview-device-card::before{content:"";position:absolute;inset:-20px;background:var(--pbg) center/cover;filter:blur(22px) brightness(.65)}
.sim-image{position:relative;z-index:1;object-fit:contain!important}
</style>

