};
var A={'sliders-h':'sliders','circle-check':'check-circle','check-double':'check','book-open':'book','rotate':'refresh','cloud-arrow-up':'upload','paper-plane':'send','mobile-screen-button':'phone','location-dot':'pin','triangle-exclamation':'alert','info-circle':'info','edit':'pencil','trash-alt':'trash','layer-group':'layers','chevron-right':'chev','circle-notch':'spinner','wand-magic-sparkles':'sparkle','ruler-combined':'ruler','hands-praying':'heart','om':'sparkle','shield-halved':'shield'};
var SKIP={spin:1,fw:1,lg:1,solid:1,regular:1};
function icon(el){
var name=null,spin=false,sz='',ex=[];
[].slice.call(el.classList).forEach(function(c){
if(c==='fa-spin'){spin=true;return}
var m=/^fa-([2-4])x$/.exec(c);if(m){sz=m[1];return}
if(c==='fas'||c==='far'||c==='fab'||c==='fa-solid'||c==='fa-regular')return;
if(c.indexOf('fa-')===0){var n=c.slice(3);if(SKIP[n])return;n=A[n]||n;if(P[n]&&!name)name=n;return}
ex.push(c)});
if(!name)return;
if(name==='spinner')spin=true;
var s=document.createElementNS('http://www.w3.org/2000/svg','svg');
s.setAttribute('viewBox','0 0 24 24');s.setAttribute('aria-hidden','true');
s.setAttribute('class','ico'+(spin?' spin':'')+(ex.length?' '+ex.join(' '):''));
var st=el.getAttribute('style');if(st)s.setAttribute('style',st);
if(sz){s.style.width=sz+'em';s.style.height=sz+'em'}
s.innerHTML=P[name];el.replaceWith(s)}
function icons(r){if(r.nodeType!==1)return;if(r.matches&&r.matches('i[class*="fa-"]'))icon(r);r.querySelectorAll('i[class*="fa-"]').forEach(icon)}

var D='श्री श्री राधाकृष्ण चंद्र मंदिर|Sri Sri Radha Krishna Chandra Temple|श्री श्री राधाकृष्ण चंद्र मंदिर\n'+
'श्री श्री राधाकृष्ण चंद्र|Sri Sri Radha Krishna Chandra|श्री श्री राधाकृष्ण चंद्र\n'+
'मंदिर मास्टर एडमिन|Temple Master Admin|मंदिर मास्टर ॲडमिन\n'+
'स्लाइडर व सूचना हब|Slider & Notice Hub|स्लाइडर व सूचना केंद्र\n'+
'क्विज़ डेटाबेस कंट्रोलर|Quiz Database Controller|क्विझ डेटाबेस कंट्रोलर\n'+
